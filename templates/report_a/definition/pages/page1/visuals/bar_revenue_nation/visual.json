{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "bar_revenue_nation",
  "position": {
    "x": 24,
    "y": 168,
    "z": 1,
    "width": 760,
    "height": 440,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "nation"
                    }
                  },
                  "Property": "n_name"
                }
              },
              "queryRef": "nation.n_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "lineitem"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}